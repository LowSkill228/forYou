  return agents.map((agent) => ({

    params: {

      slug: agent.slug

    },

    props: {

      agent

    }

  }));

}

const agent = Astro.props.agent;
const hasAsset = (path: string) => existsSync(resolve('public', path));

const roleIcons = {

  DUELIST: "images/duel.png",

  CONTROLLER: "images/cont.png",

  INITIATOR: "images/int.png",

  SENTINEL: "images/sent.png"

};

const roleIcon =

  roleIcons[agent.role as keyof typeof roleIcons];

const firstAbility =

  agent.abilities[0];

---

<BaseLayout title={`GAMESENSE — ${agent.name}`}>

  <div class="agent-page">

    <a

      href={`${import.meta.env.BASE_URL}valorant/`}

      class="agent-page__back"

    id="back-to-agents"
    >

      ← НАЗАД К АГЕНТАМ

    </a>



    <section class="agent-hero">

      <div class="agent-hero__visual">

        <div class="agent-hero__ambient"></div>

        <div

          class="agent-hero__ambient

          agent-hero__ambient--blue"

        ></div>

        <div class="agent-hero__wind agent-hero__wind--one"></div>

        <div class="agent-hero__wind agent-hero__wind--two"></div>

        <div class="agent-hero__wind agent-hero__wind--three"></div>

        <img

          src={`${import.meta.env.BASE_URL}${agent.image}`}

          alt={agent.name}

          class="agent-hero__image"

        />

        <span class="agent-hero__watermark">

          {agent.name}

        </span>

      </div>



      <div class="agent-hero__panel">
      <div class="agent-hero__content">

        <span class="agent-hero__eyebrow">

          VALORANT AGENT

        </span>

        <div class="agent-hero__role-badge">

          <img

            src={`${import.meta.env.BASE_URL}${roleIcon}`}

            alt=""

            class="agent-hero__role-icon"

          />

          <span>

            {agent.role}

          </span>

        </div>



        <h1>

          {agent.name}

        </h1>



        <p class="agent-hero__description">

          {agent.description}

        </p>



        <div class="agent-hero__attributes">

          <span class="agent-hero__attributes-title">

            АТРИБУТЫ

          </span>

          <div class="agent-hero__tags">

            {agent.attributes.map((attribute: string) => (

              <span>{attribute}</span>

            ))}

          </div>

        </div>



        <div class="agent-hero__abilities">

          <span class="agent-hero__abilities-title">

            СПОСОБНОСТИ

          </span>

          <div class="agent-hero__abilities-list">

            {agent.abilities.map((ability: any) => (

              <button

                class="agent-hero__ability"

                type="button"

                data-ability={ability.id}

                data-key={ability.key}

                data-name={ability.name}

                data-description={`Демонстрация способности ${ability.name} агента ${agent.name}.`}

                data-video={hasAsset(ability.video) ? `${import.meta.env.BASE_URL}${ability.video}` : ''}
                aria-expanded="false"
                aria-controls="ability-preview"

                aria-label={ability.name}

                title={ability.name}

              >

                <span class="agent-hero__ability-key">

                  {ability.key}

                </span>

                {hasAsset(ability.icon) ? <img

                  src={`${import.meta.env.BASE_URL}${ability.icon}`}

                  alt={ability.name}

                /> : <span class="agent-hero__ability-fallback" aria-hidden="true">{ability.key}</span>}

              </button>

            ))}

          </div>

        </div>

      </div>



      <div

        class="ability-preview"

        id="ability-preview"

        aria-hidden="true"

      >

        <button

          class="ability-preview__close"

          id="ability-preview-close"

          type="button"

          aria-label="Закрыть"

        >

          ×

        </button>



        <div class="ability-preview__media">
          <p id="ability-preview-unavailable" hidden>Видео этой способности пока не добавлено.</p>

          <video

            id="ability-preview-video"

            muted

            loop

            playsinline

            preload="metadata"

          >

            <source

              id="ability-preview-source"

              src=""

              type="video/mp4"

            />

          </video>

        </div>



        <div class="ability-preview__info">

          <span id="ability-preview-key">

            {firstAbility.key}

          </span>

          <div>

            <h3 id="ability-preview-name">

              {firstAbility.name}

            </h3>

            <p id="ability-preview-description">

              Нажми на способность, чтобы посмотреть её в действии.

            </p>

          </div>

        </div>

      </div>

      </div>
    </section>

  </div>



  <script>

    const preview =

      document.getElementById(

        "ability-preview"

      );

    const video =

      document.getElementById(

        "ability-preview-video"

      ) as HTMLVideoElement | null;

    const source =

      document.getElementById(

        "ability-preview-source"

      ) as HTMLSourceElement | null;

    const previewKey =

      document.getElementById(

        "ability-preview-key"

      );

    const previewName =

      document.getElementById(

        "ability-preview-name"

      );

    const previewDescription =

      document.getElementById(

        "ability-preview-description"

      );

    const closeButton =

      document.getElementById(

        "ability-preview-close"

      );

    const abilityButtons =

      document.querySelectorAll<HTMLButtonElement>(

        ".agent-hero__ability[data-ability]"

      );

    let activeAbility:

      string | null = null;



    function closePreview() {
      abilityButtons.forEach((button) => button.setAttribute('aria-expanded', 'false'));

      activeAbility = null;

      preview?.classList.remove(

        "is-open"

      );

      preview?.setAttribute(

        "aria-hidden",

        "true"

      );

      abilityButtons.forEach(

        (button) => {

          button.classList.remove(

            "is-active"

          );

        }

      );

      if (video) {

        video.pause();

        video.currentTime = 0;

      }

    }



    function openPreview(

      button: HTMLButtonElement

    ) {

      const abilityId =

        button.dataset.ability;

      if (!abilityId) {

        return;

      }

      activeAbility =

        abilityId;

      abilityButtons.forEach(

        (item) => {

          item.classList.remove(

            "is-active"

          );

        }

      );

      button.classList.add(

        "is-active"

      );
      abilityButtons.forEach((item) => item.setAttribute('aria-expanded', String(item === button)));

      if (previewKey) {

        previewKey.textContent =

          button.dataset.key ?? "";

      }

      if (previewName) {

        previewName.textContent =

          button.dataset.name ?? "";

      }

      if (previewDescription) {

        previewDescription.textContent =

          button.dataset.description ?? "";

      }

      preview?.classList.add(

        "is-open"

      );

      preview?.setAttribute(

        "aria-hidden",

        "false"

      );

      if (

        video &&

        source

      ) {
        const available = Boolean(button.dataset.video);
        preview?.classList.toggle('has-no-video', !available);
        video.hidden = !available;
        const unavailable = document.getElementById('ability-preview-unavailable');
        if (unavailable) unavailable.hidden = available;
        if (!available) {
          video.pause();
          source.removeAttribute('src');
          video.load();
          return;
        }

        video.pause();

        source.src =

          button.dataset.video ?? "";

        video.load();

        video

          .play()

          .catch(() => {});

      }

    }



    abilityButtons.forEach(

      (button) => {

        button.addEventListener(

          "click",

          () => {

            const abilityId =

              button.dataset.ability;

            if (!abilityId) {

              return;

            }

            if (

              activeAbility === abilityId &&

              preview?.classList.contains(

                "is-open"

              )

            ) {

              closePreview();

              return;

            }

            openPreview(

              button

            );

          }

        );

      }

    );



    closeButton?.addEventListener(

      "click",

      closePreview

    );

  

    /* ==================================================
       FAST RETURN TO VALORANT
       ================================================== */

    const backToAgents =
      document.getElementById(
        "back-to-agents"
      );


    backToAgents?.addEventListener(
      "click",
      (event) => {

        const cameFromValorant =
          sessionStorage.getItem(
            "gamesense:cameFromValorant"
          ) === "1";


        /*
          Если страницу агента открыли из нашей галереи,
          возвращаемся через browser history.
          Так Valorant-страница может восстановиться из BFCache
          уже полностью готовой: без повторной отрисовки кусками,
          без ручного scrollTo и без пересборки каруселей.
        */
        if (
          cameFromValorant &&
          window.history.length > 1
        ) {

          event.preventDefault();

          sessionStorage.removeItem(
            "gamesense:cameFromValorant"
          );

          if (video) {
            video.pause();
          }

          window.history.back();

          return;
        }


        /*
          Если агент открыт напрямую или в новой вкладке —
          оставляем обычный href как безопасный fallback.
        */
        sessionStorage.setItem(
          "gamesense:returnToValorant",
          "1"
        );

      }
    );

</script>

</BaseLayout>



<style>

.agent-page {

  position: relative;

  width: min(

    1460px,

    calc(100vw - 40px)

  );

  margin: 0 auto;

  padding:

    90px 0 70px;

}



/* ==============================

   BACK BUTTON

   ============================== */

.agent-page__back {

  position: absolute;

  top: 30px;

  left: 0;

  z-index: 40;

  display: inline-flex;

  align-items: center;

  color:

    rgba(255, 255, 255, 0.52);

  text-decoration: none;

  font-size: 0.6rem;

  font-weight: 800;

  letter-spacing: 0.1em;

