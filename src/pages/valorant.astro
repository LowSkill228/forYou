---

<BaseLayout title="GAMESENSE — Valorant">

  <div class="page-transition">

    <div class="layout">

      <!-- ============================================
           BRAND
           ============================================ -->

      <header class="brand">

        <h1 class="brand__title">
          GAME<span>SENSE</span>
        </h1>

        <p class="brand__subtitle">
          Check Detailed Valorant Stats and Leaderboards
        </p>

      </header>


      <!-- ============================================
           MAIN GAME SECTION
           ============================================ -->

      <section class="game-section">

        <div class="game-row">


          <!-- ============================================
               VALORANT
               ============================================ -->

          <div class="games-grid">

            {games.map((game) => (

              <div
                class="game-card"
                style={`--game-bg: url("${game.image}")`}
              >

                <div class="game-card__art"></div>

                <div class="game-card__content">

                  <span class="game-card__eyebrow">
                    GAMESENSE GUIDE
                  </span>

                  <h3>
                    VALORANT
                  </h3>

                  <div class="game-card__intro">

                    <strong>
                      Не знаешь с чего начать?
                    </strong>

                    <p>
                      Начинай с разделов и изучай по полной!
                    </p>

                  </div>

                  <div class="game-card__features">

                    <span
                      class="game-card__feature"
                      data-highlight="agents"
                    >
                      АГЕНТЫ
                    </span>

                    <span
                      class="game-card__feature"
                      data-highlight="weapons"
                    >
                      ОРУЖИЕ
                    </span>

                    <span
                      class="game-card__feature"
                      data-highlight="maps"
                    >
                      КАРТЫ
                    </span>

                  </div>

                </div>

              </div>

            ))}

          </div>


          <!-- ============================================
               INFO CARDS
               ============================================ -->

          <div class="info-cards">

            <a
              href="#agent-roles"
              class="info-card"
              id="agents-toggle"
              data-section="agents"
            >

              <img
                src={`${import.meta.env.BASE_URL}images/agents-logo.png`}
                alt="Агенты"
                class="info-card__image"
              />

            </a>


            <a
              href="#weapons-content"
              class="info-card"
              id="weapons-toggle"
              data-section="weapons"
            >
              <img
                src={`${import.meta.env.BASE_URL}images/weapons-card-v1.png`}
                alt="Оружие"
                class="info-card__artwork"
              />
            </a>


            <a
              href="#maps-content"
              class="info-card"
              id="maps-toggle"
              aria-controls="maps-content"
              aria-expanded="false"
              data-section="maps"
            >
              <img
                src={`${import.meta.env.BASE_URL}images/maps-card-v1.png`}
                alt="Карты"
                class="info-card__artwork"
              />
            </a>

          </div>


          <!-- ============================================
               PROMO
               ============================================ -->

          <a
            href="#guide-content"
            class="promo"
            id="guide-toggle"
            aria-controls="guide-content"
            aria-expanded="false"
          >

            <div class="promo__art">

              <img
                src={`${import.meta.env.BASE_URL}images/logo_main_right2.png`}
