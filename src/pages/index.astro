---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="GAMESENSE — Главная">
  <div class="page-transition">
  <main class="home">
    <h1>GAMESENSE</h1>
    <p>New homepage coming soon</p>
  </main>
  </div>
</BaseLayout>

<style>
  .home {
    min-height: 70vh;

    display: flex;
    flex-direction: column;

    align-items: center;
    justify-content: center;

    text-align: center;
  }

  .home h1 {
    margin: 0;

    font-size: clamp(1.65rem, 7vw, 3rem);
    font-weight: 900;

    letter-spacing: clamp(1px, .5vw, 4px);
  }

  .home p {
    margin-top: 0.75rem;

    color: rgba(255, 255, 255, 0.55);
  }
  
</style>
