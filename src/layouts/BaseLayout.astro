---
import '../styles/global.css';

const { title = "GAMESENSE" } = Astro.props;
---
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.ico`} sizes="any" />
    <title>{title}</title>
  </head>
  <body>
    <header class="topbar">
  <a class="logo" href={import.meta.env.BASE_URL}>
  <span class="logo__mark">G</span>

  <span class="logo__text">
    GAME<span>SENSE</span>
  </span>
</a>

  <nav class="main-nav">
   <a href={`${import.meta.env.BASE_URL}valorant`} class="nav-item">
  <img src={`${import.meta.env.BASE_URL}images/valorant.png`} alt="" class="nav-icon" />
  
  <span>Valorant</span>
</a>
  </nav>

  <div class="auth">
    <a href="/login" class="sign-in">
      <span class="sign-in-icon">⏻</span>
      <span>Sign In</span>
    </a>
  </div>
</header>
    <main>
      <slot />
    </main>
  </body>
</html>
